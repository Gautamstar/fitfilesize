# Base URL of the FitPDF API.
#
# Leave EMPTY for local development: vite.config.ts proxies /api and /health to
# http://localhost:8000, so relative paths hit the backend on the same origin
# and CORS never applies.
#
# For a production build, set this to the deployed backend origin, e.g.
#   VITE_API_URL=https://fitpdf.onrender.com
# and set ALLOWED_ORIGINS on the backend to the frontend's origin.
#
# Only variables prefixed with VITE_ are exposed to client code, and anything
# here ends up readable in the shipped bundle. Never put a secret in this file.
VITE_API_URL=

# Public origin of this site, e.g.
#   VITE_SITE_URL=https://fitfilesize.com
# Used at build time by scripts/seo-pages.mjs for canonical URLs, og:url and
# sitemap.xml. Production's value is committed in .env.production; leave it
# empty here so local builds leave those out.
VITE_SITE_URL=

# Stripe Payment Link for tips ("customers choose what to pay"), e.g.
#   VITE_TIP_URL=https://buy.stripe.com/...
# Empty means no tip link is shown anywhere.
VITE_TIP_URL=
