# Copy to deploy/.env on the server and fill in. Never commit the real file.

# The site's origins, comma-separated. Without them the browser blocks every call.
ALLOWED_ORIGINS=https://fitfilesize.com,https://www.fitfilesize.com

# From Cloudflare Zero Trust: Networks > Tunnels > your tunnel > install command.
# It works like a password for the tunnel.
TUNNEL_TOKEN=

# Largest upload in bytes (50 MiB). Uploads stream to disk, so memory is not
# the limit; the site reads it from /api/limits, so nothing else needs changing.
# Cloudflare's free plan refuses request bodies over 100 MB.
FITPDF_MAX_UPLOAD=52428800
